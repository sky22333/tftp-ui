// 简洁布局，交互控件使用 Slint 标准组件。

import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct LogEntry {
    time: string,
    client: string,
    kind: string,
    file: string,
    size: string,
}

global Theme {
    out property <color> bg: #F2F3F5;
    out property <color> card: #FFFFFF;
    out property <color> row-alt: #FAFBFC;
    out property <color> border: #E3E6EA;
    out property <color> text: #1F2329;
    out property <color> muted: #8A9099;
    out property <color> faint: #B6BBC3;
    out property <color> accent: #2563EB;
    out property <color> danger: #E5484D;
    out property <color> ok: #12B76A;

    out property <length> field-height: 32px;
}

component FieldLabel inherits Text {
    width: 60px;
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
    horizontal-alignment: left;
}

export component AppWindow inherits Window {
    title: "TFTP 服务端";
    icon: @image-url("../assets/icon.png");
    width: 560px;
    height: 540px;
    background: Theme.bg;
    default-font-family: "Microsoft YaHei";
    default-font-size: 13px;

    in-out property <bool> running: false;
    in-out property <bool> busy: false;
    in-out property <int> adapter-index: 0;
    in property <[string]> adapters: [];
    in-out property <string> port-text: "69";
    in-out property <string> dir-text: "";
    in-out property <string> hint: "";
    in-out property <bool> hint-error: false;
    in property <[LogEntry]> logs: [];
    in-out property <length> log-scroll: 0px;
    out property <length> log-max-scroll: log-view.content-height - log-view.height;

    callback toggle-requested();
    callback browse-requested();
    callback clear-requested();
    callback refresh-adapters-requested();

    // 标题栏由 DWM 绘制、随系统强调色变化，无法匹配；用一条虚线边界把色差解释为层级。
    // Slint 无虚线描边（Path 不支持 dash），用短划矩形拼接：4px 实 + 3px 空。
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;

        for i in 80: Rectangle {
            x: i * 7px;
            y: 0;
            width: 4px;
            height: 1px;
            background: #C2C8D1;
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            height: 28px;
            Text {
                text: "TFTP 文件服务器";
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle { }
        }

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.field-height;
                    FieldLabel { text: "监听地址"; }
                    ComboBox {
                        horizontal-stretch: 1;
                        enabled: !root.running && !root.busy;
                        model: root.adapters;
                        current-index <=> root.adapter-index;
                        changed has-focus => {
                            if self.has-focus && self.enabled { root.refresh-adapters-requested(); }
                        }
                    }
                    Button {
                        icon: @image-url("../assets/refresh.svg");
                        icon-size: 16px;
                        colorize-icon: true;
                        enabled: !root.running && !root.busy;
                        accessible-label: "刷新地址";
                        Tooltip { text: @markdown("刷新地址"); }
                        clicked => { root.refresh-adapters-requested(); }
                    }
                }

                // 端口框固定宽度，右侧说明右对齐，与上下两行同栅格
                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.field-height;
                    FieldLabel { text: "端口"; }
                    LineEdit {
                        width: 160px;
                        enabled: !root.running && !root.busy;
                        text <=> root.port-text;
                    }
                    Rectangle { }
                    Text {
                        text: "默认 69";
                        color: Theme.faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.field-height;
                    FieldLabel { text: "根目录"; }
                    LineEdit {
                        enabled: !root.running && !root.busy;
                        text <=> root.dir-text;
                        placeholder-text: "选择根目录";
                    }
                    Button {
                        icon: @image-url("../assets/folder.svg");
                        icon-size: 16px;
                        colorize-icon: true;
                        accessible-label: "选择根目录";
                        Tooltip { text: @markdown("选择根目录"); }
                        enabled: !root.running && !root.busy;
                        clicked => { root.browse-requested(); }
                    }
                }
            }
        }

        Text {
            height: 16px;
            text: root.hint;
            color: root.hint-error ? Theme.danger : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Button {
            height: 38px;
            primary: true;
            enabled: !root.busy;
            text: root.busy ? "请稍候…" : (root.running ? "停止服务" : "启动服务");
            clicked => { root.toggle-requested(); }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 6px;
                spacing: 6px;

                HorizontalLayout {
                    height: 32px;
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: "运行日志";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    FocusScope {
                        width: 32px;
                        height: 32px;
                        enabled: root.logs.length > 0;
                        accessible-role: button;
                        accessible-label: "清空日志";
                        accessible-enabled: self.enabled;
                        accessible-action-default => { if self.enabled { root.clear-requested(); } }
                        Tooltip { text: @markdown("清空日志"); }
                        Image {
                            x: 8px;
                            y: 8px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../assets/clear.svg");
                            opacity: parent.enabled ? 1 : 0.4;
                        }
                        TouchArea {
                            enabled: parent.enabled;
                            clicked => { root.clear-requested(); }
                        }
                        key-pressed(event) => {
                            if self.enabled && (event.text == Key.Space || event.text == Key.Return) {
                                root.clear-requested();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                HorizontalLayout {
                    height: 18px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    Text { text: "时间"; width: 56px; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "客户端"; width: 106px; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "事件"; width: 48px; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "文件"; horizontal-stretch: 1; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "大小"; width: 54px; color: #A8AEB7; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                }

                Rectangle { height: 1px; background: Theme.border; }

                log-view := ScrollView {
                    vertical-stretch: 1;
                    content-y <=> root.log-scroll;

                    VerticalLayout {
                        for entry[i] in root.logs : Rectangle {
                            height: 23px;
                            background: Math.mod(i, 2) == 0 ? Theme.row-alt : Theme.card;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                Text {
                                    text: entry.time;
                                    width: 56px;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.client;
                                    width: 106px;
                                    color: Theme.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: entry.kind;
                                    width: 48px;
                                    color: entry.kind == "拒绝" ? Theme.danger : (entry.kind == "系统" ? Theme.muted : Theme.accent);
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.file;
                                    horizontal-stretch: 1;
                                    color: Theme.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: entry.size;
                                    width: 54px;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.logs.length == 0 : Text {
                            height: 44px;
                            text: "暂无记录，启动服务后这里会实时显示客户端请求";
                            color: Theme.faint;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 状态胶囊放最后，保证绘制在最上层
    Rectangle {
        x: parent.width - 16px - 86px;
        y: 16px;
        width: 86px;
        height: 24px;
        border-radius: 12px;
        background: root.running ? #E9F8F1 : #EDEFF2;

        Rectangle {
            x: 9px;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.running ? Theme.ok : #B0B5BD;
        }

        Text {
            x: 22px;
            y: 0px;
            width: parent.width - 22px;
            height: parent.height;
            text: root.running ? "运行中" : "已停止";
            color: root.running ? #0B7A46 : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

}
