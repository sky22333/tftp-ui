// 扁平化界面：小工具尺寸、单一强调色、无阴影，软件渲染友好；输入类控件统一走 Field

import { ScrollView } from "std-widgets.slint";

export struct LogEntry {
    time: string,
    client: string,
    kind: string,
    file: string,
    size: string,
}

global Theme {
    out property <color> bg: #F2F3F5;
    out property <color> card: #FFFFFF;
    out property <color> row-alt: #FAFBFC;
    out property <color> border: #E3E6EA;
    out property <color> text: #1F2329;
    out property <color> muted: #8A9099;
    out property <color> faint: #B6BBC3;
    out property <color> accent: #2563EB;
    out property <color> accent-dim: #3B7BF6;
    out property <color> accent-press: #1E4FC4;
    out property <color> danger: #E5484D;
    out property <color> danger-press: #C73338;
    out property <color> ok: #12B76A;

    // 输入框几何的唯一来源
    out property <length> field-height: 32px;
    out property <length> field-radius: 5px;
    out property <length> field-pad: 10px;
}

component FieldLabel inherits Text {
    width: 60px;
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
    horizontal-alignment: left;
}

// 唯一的输入框实现。readonly 供下拉框复用；未聚焦时用可省略的 Text 覆盖显示，避免长路径被硬切
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> readonly: false;
    in property <bool> open: false;
    out property <bool> focused: input.has-focus;

    height: Theme.field-height;
    border-radius: Theme.field-radius;
    border-width: 1px;
    border-color: (root.open || root.focused) ? Theme.accent : Theme.border;
    background: Theme.card;

    input := TextInput {
        x: Theme.field-pad;
        width: parent.width - Theme.field-pad * 2;
        height: parent.height;
        text <=> root.text;
        read-only: root.readonly;
        color: root.readonly || !input.has-focus ? transparent : Theme.text;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
    }

    if !root.focused : Text {
        x: Theme.field-pad;
        width: parent.width - (root.readonly ? Theme.field-pad * 2 + 12px : Theme.field-pad * 2);
        height: parent.height;
        text: root.text == "" ? root.placeholder : root.text;
        color: root.text == "" ? Theme.faint : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// 下拉框 = Field(readonly) + 箭头 + 点击区
component SelectField inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <float> progress: 0;
    callback open-requested(Point, length, length);

    f := Field {
        width: parent.width;
        height: parent.height;
        text: root.text;
        readonly: true;
        open: root.open;
    }

    // 两张小箭头交叉淡入淡出实现翻转（Path 无旋转属性）
    Path {
        x: parent.width - 22px;
        y: parent.height / 2 - 3px;
        width: 10px;
        height: 6px;
        commands: "M 0 0 L 5 5 L 10 0";
        stroke: root.open || touch.has-hover ? Theme.accent : #9AA0A8;
        stroke-width: 1.6px;
        fill: transparent;
        opacity: 1 - root.progress;
    }

    Path {
        x: parent.width - 22px;
        y: parent.height / 2 - 3px;
        width: 10px;
        height: 6px;
        commands: "M 0 5 L 5 0 L 10 5";
        stroke: root.open || touch.has-hover ? Theme.accent : #9AA0A8;
        stroke-width: 1.6px;
        fill: transparent;
        opacity: root.progress;
    }

    touch := TouchArea {
        clicked => { root.open-requested(self.absolute-position, self.width, self.height); }
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: Theme.field-height;
    border-radius: Theme.field-radius;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    background: touch.pressed ? #EDF2FE : (touch.has-hover ? #F7F9FC : Theme.card);

    Text {
        text: root.label;
        color: touch.has-hover ? Theme.accent : Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "TFTP 服务端";
    icon: @image-url("../assets/icon.png");
    width: 560px;
    height: 540px;
    background: Theme.bg;
    default-font-family: "Microsoft YaHei";
    default-font-size: 13px;

    in-out property <bool> running: false;
    in-out property <bool> busy: false;
    in-out property <int> adapter-index: 0;
    in property <[string]> adapters: [];
    in-out property <string> port-text: "69";
    in-out property <string> dir-text: "";
    in-out property <string> hint: "";
    in-out property <bool> hint-error: false;
    in property <[LogEntry]> logs: [];
    in-out property <length> log-scroll: 0px;
    out property <length> log-max-scroll: log-view.content-height - log-view.height;

    in-out property <bool> picker-open: false;
    in-out property <length> picker-x: 0px;
    in-out property <length> picker-y: 0px;
    in-out property <length> picker-w: 200px;
    // 由 picker-open 派生 + animate：动画挂在属性上，元素创建/销毁不会打断它
    in-out property <float> picker-a: root.picker-open ? 1 : 0;
    animate picker-a { duration: 130ms; easing: ease-out; }

    callback toggle-requested();
    callback browse-requested();
    callback clear-requested();

    // 标题栏由 DWM 绘制、随系统强调色变化，无法匹配；用一条虚线边界把色差解释为层级。
    // Slint 无虚线描边（Path 不支持 dash），用短划矩形拼接：4px 实 + 3px 空。
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;

        for i in 80: Rectangle {
            x: i * 7px;
            y: 0;
            width: 4px;
            height: 1px;
            background: #C2C8D1;
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            height: 28px;
            Text {
                text: "TFTP 文件服务器";
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle { }
        }

        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.field-height;
                    FieldLabel { text: "监听地址"; }
                    SelectField {
                        horizontal-stretch: 1;
                        text: root.adapters.length > 0 && root.adapter-index >= 0 && root.adapter-index < root.adapters.length
                            ? root.adapters[root.adapter-index] : "";
                        open: root.picker-open;
                        progress: root.picker-a;
                        open-requested(pos, w, h) => {
                            root.picker-x = pos.x;
                            root.picker-y = pos.y + h;
                            root.picker-w = w;
                            root.picker-open = true;
                        }
                    }
                }

                // 端口框固定宽度，右侧说明右对齐，与上下两行同栅格
                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.field-height;
                    FieldLabel { text: "端口"; }
                    Field {
                        width: 96px;
                        text <=> root.port-text;
                    }
                    Rectangle { }
                    Text {
                        text: "默认 69";
                        color: Theme.faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.field-height;
                    FieldLabel { text: "根目录"; }
                    Field {
                        text <=> root.dir-text;
                        placeholder: "点击右侧选择目录";
                    }
                    GhostButton {
                        width: 64px;
                        label: "浏览";
                        clicked => { root.browse-requested(); }
                    }
                }
            }
        }

        Text {
            height: 16px;
            text: root.hint;
            color: root.hint-error ? Theme.danger : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            height: 38px;
            border-radius: 6px;
            background: root.busy
                ? #C9CDD4
                : (root.running
                    ? (main-touch.pressed ? Theme.danger-press : (main-touch.has-hover ? #EE5F63 : Theme.danger))
                    : (main-touch.pressed ? Theme.accent-press : (main-touch.has-hover ? Theme.accent-dim : Theme.accent)));

            Text {
                text: root.busy ? "请稍候…" : (root.running ? "停止服务" : "启动服务");
                color: #FFFFFF;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            main-touch := TouchArea {
                clicked => {
                    if (!root.busy) { root.toggle-requested(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 6px;
                spacing: 6px;

                HorizontalLayout {
                    height: 20px;
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: "运行日志";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    Text {
                        text: "清空";
                        font-size: 11px;
                        color: clear-touch.has-hover ? Theme.danger : Theme.muted;
                        vertical-alignment: center;
                        clear-touch := TouchArea {
                            clicked => { root.clear-requested(); }
                        }
                    }
                }

                HorizontalLayout {
                    height: 18px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    Text { text: "时间"; width: 56px; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "客户端"; width: 106px; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "操作"; width: 32px; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "文件"; horizontal-stretch: 1; color: #A8AEB7; font-size: 10px; vertical-alignment: center; }
                    Text { text: "大小"; width: 54px; color: #A8AEB7; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                }

                Rectangle { height: 1px; background: Theme.border; }

                log-view := ScrollView {
                    vertical-stretch: 1;
                    content-y <=> root.log-scroll;

                    VerticalLayout {
                        for entry[i] in root.logs : Rectangle {
                            height: 23px;
                            background: Math.mod(i, 2) == 0 ? Theme.row-alt : Theme.card;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                Text {
                                    text: entry.time;
                                    width: 56px;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.client;
                                    width: 106px;
                                    color: Theme.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: entry.kind;
                                    width: 32px;
                                    color: entry.kind == "写入" ? #E08700 : (entry.kind == "读取" ? Theme.accent : (entry.kind == "系统" ? Theme.muted : Theme.danger));
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.file;
                                    horizontal-stretch: 1;
                                    color: Theme.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: entry.size;
                                    width: 54px;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.logs.length == 0 : Text {
                            height: 44px;
                            text: "暂无记录，启动服务后这里会实时显示客户端请求";
                            color: Theme.faint;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 状态胶囊放最后，保证绘制在最上层
    Rectangle {
        x: parent.width - 16px - 86px;
        y: 16px;
        width: 86px;
        height: 24px;
        border-radius: 12px;
        background: root.running ? #E9F8F1 : #EDEFF2;

        Rectangle {
            x: 9px;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.running ? Theme.ok : #B0B5BD;
        }

        Text {
            x: 22px;
            y: 0px;
            width: parent.width - 22px;
            height: parent.height;
            text: root.running ? "运行中" : "已停止";
            color: root.running ? #0B7A46 : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    // 下拉覆盖层：淡入 + 轻微位移，picker-a 归零后移除。
    // 遮罩的透明度必须落在子元素上，落在容器上会把面板一起压暗。
    if root.picker-a > 0.02 : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        Rectangle {
            background: #1F2329;
            opacity: root.picker-a * 0.10;
        }

        bg-dismiss := TouchArea {
            clicked => {
                root.picker-open = false;
            }
        }

        Rectangle {
            x: root.picker-x;
            y: root.picker-y + 4px - (1 - root.picker-a) * 8px;
            width: root.picker-w;
            height: min(root.adapters.length * 30px + 12px, 264px);
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.card;
            opacity: root.picker-a;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    for option[i] in root.adapters : Rectangle {
                        height: 30px;
                        border-radius: 4px;
                        background: i == root.adapter-index
                            ? #EDF2FE
                            : (opt-touch.has-hover ? #F5F7FA : transparent);

                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: option;
                            color: i == root.adapter-index ? Theme.accent : Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        opt-touch := TouchArea {
                            clicked => {
                                root.adapter-index = i;
                                root.picker-open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
